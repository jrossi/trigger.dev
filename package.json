      "@sentry/remix@9.46.0": "patches/@sentry__remix@9.46.0.patch",
      "@upstash/ratelimit@1.1.3": "patches/@upstash__ratelimit.patch",
      "antlr4ts@0.5.0-alpha.4": "patches/antlr4ts@0.5.0-alpha.4.patch"
